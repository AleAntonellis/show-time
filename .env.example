# --- TMDB (The Movie Database) ---
# Credenziali gratuite: https://www.themoviedb.org/settings/api
#
# Copia questo file in ".env.local" (NON committato) e inserisci la tua chiave.
# Usa UNA delle due opzioni:

# Opzione consigliata: "API Read Access Token" (v4)
EXPO_PUBLIC_TMDB_ACCESS_TOKEN=

# In alternativa: "API Key" (v3)
# EXPO_PUBLIC_TMDB_API_KEY=


# --- Supabase (auth + database) ---
# Project Settings → API su https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

